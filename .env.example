# =============================================================================
# Passem a Respeitar — variaveis de ambiente
# =============================================================================
#
# Copie para .env.local e preencha. NUNCA commite .env.local.
# Este arquivo so tem NOMES, nenhum valor real.
#
# REGRA QUE NAO SE NEGOCIA:
#   NEXT_PUBLIC_* vai para o bundle do navegador e qualquer visitante le.
#   Use esse prefixo SO para chave publica. Nunca para chave de servico,
#   token de gateway, segredo de webhook ou senha.
#
# Na Vercel, cadastre cada variavel nos tres ambientes (Production, Preview,
# Development), menos as de teste do gateway, que ficam fora de Production.
# =============================================================================


# --- Site --------------------------------------------------------------------
# URL canonica. Usada em link de e-mail, Open Graph, CORS e retorno do checkout.
# Local: http://localhost:3000. Producao: o dominio final (Issue #54).
NEXT_PUBLIC_SITE_URL=


# --- Supabase (Issues #12 e #18) ---------------------------------------------
# Projeto `cbac principal`, regiao sa-east-1 (Sao Paulo).
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica do cliente. O nome e PUBLISHABLE, nao ANON: o Supabase renomeou,
# e o que esta cadastrado na Vercel usa o nome novo. Ela e publica de proposito
# e sozinha nao abre nada — quem barra e a RLS das tabelas (#18).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ignora RLS e enxerga o banco inteiro. SO em route handler, server action ou
# edge function. Se esta chave cair no cliente, o banco inteiro esta aberto.
# Nunca com prefixo NEXT_PUBLIC_. (Issue #21)
#
# Pegue em Settings > API Keys > Secret keys. Comece por criar uma nova
# (`sb_secret_...`), nao pela `service_role` legada: as novas sao revogadas uma
# a uma, e rotacionar a legada troca o JWT secret do projeto e desloga todo
# mundo de uma vez.
SUPABASE_SECRET_KEY=


# --- Codigos de convite (Issue #13) ------------------------------------------
# SHA-256 de cada codigo, em hex minusculo, separados por virgula.
# NUNCA o codigo em texto puro.
#
# Gerar o hash de um codigo:
#   node -e "console.log(require('node:crypto').createHash('sha256').update('SEU_CODIGO').digest('hex'))"
CONVITE_CODIGOS_HASH=

# Chave HMAC que assina o cookie de acesso. Sem ela o cookie nao e emitido.
#
# Gerar:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONVITE_COOKIE_SECRET=

# URL do embed do teaser. Variavel de servidor de proposito: so vai para quem
# acertou o codigo. Vazio enquanto o teaser nao existe.
CONVITE_TEASER_EMBED=


# --- Sentry (Issue #8) -------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Usado so no build, para subir source map. Nunca em runtime de cliente.
SENTRY_AUTH_TOKEN=


# --- Rate limit (Issues #22 e #23) -------------------------------------------
# Upstash Redis para limite de login por IP e por e-mail, e limite global de API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# --- Mercado Pago (Issues #44 e #45) -----------------------------------------
# PENDENTE: credenciais ainda nao fornecidas.
# Use as de teste em Preview e Development; as de producao so em Production.
MERCADOPAGO_ACCESS_TOKEN=
# Valida a assinatura do webhook. Sem isso, qualquer um marca pedido como pago.
# Gerado no painel do Mercado Pago em Webhooks > Configurar notificacoes,
# DEPOIS de cadastrar a URL e os eventos. Sem ele o endpoint recusa tudo —
# falha fechada de proposito.
MERCADOPAGO_WEBHOOK_SECRET=
# Chave publica do checkout no cliente — essa pode ser NEXT_PUBLIC_.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=


# --- Bot protection (Issue #28) ----------------------------------------------
# PENDENTE: falta decidir entre Cloudflare Turnstile e hCaptcha.
# Os nomes abaixo assumem Turnstile; mudam se a escolha for outra.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# --- E-mail transacional (Issue #55) -----------------------------------------
# PENDENTE: provedor ainda nao definido (Resend, Postmark, SendGrid...).
# Configurado como SMTP customizado do Supabase Auth. O SMTP padrao do Supabase
# tem limite baixo e entregabilidade ruim, nao serve para producao.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
