# =============================================================================
# Passem a Respeitar — variaveis de ambiente
# =============================================================================
#
# Copie para .env.local e preencha. NUNCA commite .env.local.
# Este arquivo so tem NOMES, nenhum valor real.
#
# REGRA QUE NAO SE NEGOCIA:
#   NEXT_PUBLIC_* vai para o bundle do navegador e qualquer visitante le.
#   Use esse prefixo SO para chave publica. Nunca para chave de servico,
#   token de gateway, segredo de webhook ou senha.
#
# Na Vercel, cadastre cada variavel nos tres ambientes (Production, Preview,
# Development), menos as de teste do gateway, que ficam fora de Production.
# =============================================================================


# --- Site --------------------------------------------------------------------
# URL canonica. Usada em link de e-mail, Open Graph, CORS e retorno do checkout.
# Local: http://localhost:3000. Producao: o dominio final (Issue #54).
NEXT_PUBLIC_SITE_URL=


# --- Supabase (Issues #12 e #18) ---------------------------------------------
# Projeto `cbac principal`, regiao sa-east-1 (Sao Paulo).
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica do cliente. O nome e PUBLISHABLE, nao ANON: o Supabase renomeou,
# e o que esta cadastrado na Vercel usa o nome novo. Ela e publica de proposito
# e sozinha nao abre nada — quem barra e a RLS das tabelas (#18).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ignora RLS e enxerga o banco inteiro. SO em route handler, server action ou
# edge function. Se esta chave cair no cliente, o banco inteiro esta aberto.
# Nunca com prefixo NEXT_PUBLIC_. (Issue #21)
#
# Pegue em Settings > API Keys > Secret keys. Comece por criar uma nova
# (`sb_secret_...`), nao pela `service_role` legada: as novas sao revogadas uma
# a uma, e rotacionar a legada troca o JWT secret do projeto e desloga todo
# mundo de uma vez.
SUPABASE_SECRET_KEY=


# --- Codigos de convite (Issue #13) ------------------------------------------
# SHA-256 de cada codigo, em hex minusculo, separados por virgula.
# NUNCA o codigo em texto puro.
#
# Gerar o hash de um codigo:
#   node -e "console.log(require('node:crypto').createHash('sha256').update('SEU_CODIGO').digest('hex'))"
CONVITE_CODIGOS_HASH=

# Chave HMAC que assina o cookie de acesso. Sem ela o cookie nao e emitido.
#
# Gerar:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONVITE_COOKIE_SECRET=

# URL do embed do teaser. Variavel de servidor de proposito: so vai para quem
# acertou o codigo. Vazio enquanto o teaser nao existe.
CONVITE_TEASER_EMBED=


# --- Sentry (Issue #8) -------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Usado so no build, para subir source map. Nunca em runtime de cliente.
SENTRY_AUTH_TOKEN=


# --- Rate limit (Issues #22, #23 e #121) -------------------------------------
# Upstash Redis: limite compartilhado entre instancias (login, convite,
# checkout, cobranca, webhook, cron...). Sem as duas variaveis o limitador cai
# no de memoria, por instancia — funciona, so e mais fraco. Redis fora do ar ou
# lento tambem cai na memoria: nunca "deixa passar".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# --- Mercado Pago (Issues #44 e #45) -----------------------------------------
# PENDENTE: credenciais ainda nao fornecidas.
# Use as de teste em Preview e Development; as de producao so em Production.
MERCADOPAGO_ACCESS_TOKEN=
# Valida a assinatura do webhook. Sem isso, qualquer um marca pedido como pago.
# Gerado no painel do Mercado Pago em Webhooks > Configurar notificacoes,
# DEPOIS de cadastrar a URL e os eventos. Sem ele o endpoint recusa tudo —
# falha fechada de proposito.
MERCADOPAGO_WEBHOOK_SECRET=
# Segundo segredo aceito, opcional. Existe por dois motivos reais:
#  1. o painel tem uma configuracao por modo, cada uma com o SEU segredo, e as
#     duas podem apontar para esta mesma URL. Com um segredo so, metade das
#     notificacoes cai por configuracao e a recusa parece ataque;
#  2. trocar o segredo sem derrubar nada: cadastra o novo aqui, troca no
#     painel, promove para MERCADOPAGO_WEBHOOK_SECRET e limpa este.
# Aceitar dois nao afrouxa: cada um continua exigindo o HMAC correto.
MERCADOPAGO_WEBHOOK_SECRET_ALT=
# Chave publica do checkout no cliente — essa pode ser NEXT_PUBLIC_.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=


# --- Administracao (Issue #43) -----------------------------------------------
# Quem pode mudar o status de pedido, por e-mail, separados por virgula. O
# papel vive AQUI, no servidor: nunca em coluna que o cliente influencie. Vale
# so para e-mail verificado. Sem a variavel, ninguem e administrador.
ADMIN_EMAILS=


# --- Conciliacao (Issue #114) ------------------------------------------------
# Autoriza o cron de conciliacao em /api/cron/conciliacao. A Vercel manda
# "Authorization: Bearer <valor>" sozinha quando esta variavel existe. Sem ela
# a rota recusa tudo — falha fechada, como o webhook.
#
# Gerar:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=


# --- Frete (Issue #199) ------------------------------------------------------
# Melhor Envio, escolhido pelo dono em 02/10/2026: preco dos Correios pelo CEP,
# PAC ou SEDEX.
#
# Sem token ou sem CEP de origem nao ha frete, e sem frete o checkout nao cria
# pedido. Nunca vira frete zero: e falha fechada, como o webhook.
#
# Token: no painel do Melhor Envio, Integracoes > Permissoes de acesso > Gerar
# novo token, marcando SO a permissao de calcular frete. Vale um ano; quando
# vencer, o Sentry recebe "frete: nao consegui cotar" com motivo http-401.
# So no servidor. Nunca com prefixo NEXT_PUBLIC_.
MELHOR_ENVIO_TOKEN=
# CEP de onde o pacote sai. So digitos ou com hifen.
MELHOR_ENVIO_CEP_ORIGEM=
# "producao" ou vazio. Vazio usa o sandbox, que e outra conta e outro token.
# Em PRODUCAO o site so aceita "producao": token de sandbox ali seria preco de
# mentira com cara de verdade.
MELHOR_ENVIO_AMBIENTE=
# So para a suite de ponta a ponta, que aponta para um Melhor Envio falso nesta
# maquina. Ignorada em producao.
MELHOR_ENVIO_URL=
# Idem para o ViaCEP, que preenche o endereco pelo CEP (#204). O ViaCEP de
# verdade nao precisa de chave.
VIACEP_URL=
#
# Peso e medidas nao moram aqui: sao do produto, no banco (produtos.peso_gramas,
# altura_cm, largura_cm, comprimento_cm). Produto sem medida nao tem frete.


# --- Bot protection (Issue #28) ----------------------------------------------
# Cloudflare Turnstile, escolhido pelo dono em 29/09/2026.
# As duas saem do painel da Cloudflare: Turnstile > o widget do site.
#
# Sem as duas, a protecao fica desligada em desenvolvimento e em preview, e so
# a isca vale. Em PRODUCAO, sem as duas, os formularios publicos recusam todo
# envio: e de proposito, para chave apagada nao virar site sem protecao.
#
# As chaves de teste que a Cloudflare publica (1x0000...) servem aqui e na
# suite de ponta a ponta. Em producao o site as recusa.
#
# Site key: publica, vai para o bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key: so no servidor. Nunca com prefixo NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=


# --- Concierge (Issue #191) ---------------------------------------------------
# Chave do Google AI Studio (aistudio.google.com/apikey). So no servidor: a rota
# /api/concierge le daqui e fala com o Gemini; o navegador nunca ve a chave.
# Nunca com prefixo NEXT_PUBLIC_.
#
# Sem ela a rota responde 502 com uma mensagem generica e o resto do site
# segue normal. Cadastrar na Vercel em Production e Preview.
GEMINI_API_KEY=

# Tetos de perguntas do site inteiro (Issue #281), alem do limite por IP.
# Batido um deles, o concierge responde "muitas perguntas" ate a janela andar.
# Opcionais; vazio ou invalido vale o padrao.
#
# CONCIERGE_LIMITE_DIA protege a cota da chave, que o Google conta por dia.
# Padrao 1000. Ver os limites por dia (RPD) do plano em
# aistudio.google.com/rate-limit e por aqui um numero abaixo do menor deles,
# entre gemini-flash-latest e gemini-flash-lite-latest: uma pergunta pode
# virar duas chamadas, uma em cada modelo, quando o principal cai e o reserva
# responde. Se a tela mostrar uma cota so para os dois, usar a metade dela.
# Deixar folga: a janela daqui e de 24 h corridas, e a do Google vira a
# meia-noite do Pacifico. Com cobranca na chave, cada pergunta pode custar
# duas chamadas na fatura.
#
# CONCIERGE_LIMITE_HORA so espalha o dia, para a rajada do lancamento nao
# gastar a cota inteira numa hora. Padrao 300. Nao e teto de cota: 300 por
# hora sao 7.200 perguntas por dia.
CONCIERGE_LIMITE_DIA=
CONCIERGE_LIMITE_HORA=


# --- E-mail transacional (Issue #55) -----------------------------------------
# PENDENTE: provedor ainda nao definido (Resend, Postmark, SendGrid...).
# Configurado como SMTP customizado do Supabase Auth. O SMTP padrao do Supabase
# tem limite baixo e entregabilidade ruim, nao serve para producao.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# --- Quem vende (Issue #276) -------------------------------------------------
# Identificacao do vendedor que a pagina /termos mostra, como pede o Decreto
# 7.962/2013, art. 2º: nome ou razao social, CPF ou CNPJ e endereco fisico. O
# contato e o e-mail de lib/contato.ts.
#
# So no servidor. Nunca com prefixo NEXT_PUBLIC_: a pagina le e entrega o texto
# pronto. Cadastrar SO em Production, na Vercel.
#
# Em PRODUCAO, sem as tres, o site nao cobra: a tela de pagamento mostra "fora
# do ar", a rota de cobranca recusa e o Sentry recebe "venda bloqueada". E de
# proposito: vender sem identificacao do vendedor e o que a lei proibe. Em
# preview e desenvolvimento, sem elas, a pagina avisa que os dados estao sendo
# atualizados e o pagamento de teste segue funcionando.
#
# O documento aparece numa pagina publica. Com MEI ou CNPJ, ele no lugar do CPF.
VENDEDOR_NOME=
VENDEDOR_DOCUMENTO=
VENDEDOR_ENDERECO=
